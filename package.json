{
  "name": "youtube-ranking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API-key-free automated YouTube channel rankings powered by yt-dlp, GitHub Actions and GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-data.mjs",
    "build": "tsc --noEmit && node scripts/copy-data.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "echo \"No frontend unit tests (backend covered by pytest)\" && exit 0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0"
  }
}
